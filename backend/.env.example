# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database — use ONE of these options:

# Option A: single connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/facescane_auth

# Option B: separate variables (matches your .env style)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=facescane_auth

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REMEMBER_ME_EXPIRES_IN=30d

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="FaceScane Auth <your-email@gmail.com>"

# Security
BCRYPT_ROUNDS=12
FACE_MATCH_THRESHOLD=0.6
PASSWORD_RESET_EXPIRES_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
